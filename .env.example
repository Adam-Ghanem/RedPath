# RedPath safety defaults
ENVIRONMENT=lab
ALLOWED_CIDRS=192.168.56.0/24,10.10.10.0/24
DRY_RUN=true
RECON_TIMEOUT_SECONDS=30
WAZUH_INDEXER_URL=https://wazuh-indexer.local:9200
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
# Required before first bootstrap; use a random 16+ character secret in deployment.
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-secret
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SIEM_MAX_QUERY_WINDOW_HOURS=24
SIEM_REQUEST_TIMEOUT_SECONDS=20
