# RedPath safety defaults
ENVIRONMENT=lab
ALLOWED_CIDRS=192.168.56.0/24,10.10.10.0/24
DRY_RUN=true
RECON_TIMEOUT_SECONDS=30
WAZUH_INDEXER_URL=https://wazuh-indexer.local:9200
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
# Required before first bootstrap; use a random 16+ character secret in deployment.
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-secret
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SIEM_MAX_QUERY_WINDOW_HOURS=24
SIEM_REQUEST_TIMEOUT_SECONDS=20
PCAP_MAX_UPLOAD_BYTES=52428800
PCAP_MAX_PACKETS=100000
PCAP_MAX_ENDPOINTS=100
PCAP_MAX_DNS_QUERIES=500
PCAP_MAX_FLOWS=1000
PCAP_MAX_OBSERVATIONS=1000
# Replace the lab placeholder through secret management in deployed environments.
PCAP_REDACTION_SALT=replace-in-secret-manager

# AI features are opt-in and remain disabled unless explicitly enabled.
AI_FEATURES_ENABLED=false
# Choose none (rule-based), local (operator-hosted), or anthropic (external).
AI_PROVIDER=none
# External provider key is read only from the environment or deployment secret manager.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# Deprecated compatibility alias; prefer the explicit tier settings below.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Live catalog verified 2026-08-14: claude-sonnet-4-6 is available; claude-sonnet-5 was not listed.
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_TIMEOUT_SECONDS_FAST=15
ANTHROPIC_TIMEOUT_SECONDS_DEEP=30
ANTHROPIC_MAX_TOKENS=1200
ANTHROPIC_MAX_TOKENS_FAST=1200
ANTHROPIC_MAX_TOKENS_DEEP=2400
# Local mode sends requests only to this operator-controlled endpoint; no API key is used.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/api/generate
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_TIMEOUT_SECONDS=30
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=2000
AI_REQUESTS_PER_MINUTE=20
AI_DEEP_REQUESTS_PER_MINUTE=5
AI_AUDIT_LOG_PATH=./data/ai_audit.jsonl
AI_AUDIT_RETENTION_DAYS=365
AI_AUDIT_MAX_ENTRIES=10000
