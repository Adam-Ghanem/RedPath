# RedPath safety defaults
ENVIRONMENT=lab
ALLOWED_CIDRS=192.168.56.0/24,10.10.10.0/24
DRY_RUN=true
RECON_TIMEOUT_SECONDS=30
WAZUH_INDEXER_URL=https://wazuh-indexer.local:9200
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
# Required before first bootstrap; use a random 16+ character secret in deployment.
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-secret
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SIEM_MAX_QUERY_WINDOW_HOURS=24
SIEM_REQUEST_TIMEOUT_SECONDS=20
PCAP_MAX_UPLOAD_BYTES=52428800
PCAP_MAX_PACKETS=100000
PCAP_MAX_ENDPOINTS=100
PCAP_MAX_DNS_QUERIES=500
PCAP_MAX_FLOWS=1000
PCAP_MAX_OBSERVATIONS=1000
# Replace the lab placeholder through secret management in deployed environments.
PCAP_REDACTION_SALT=replace-in-secret-manager

# AI features are opt-in and remain disabled unless explicitly enabled.
AI_FEATURES_ENABLED=false
# Provider key is read only from the environment or deployment secret manager.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_TOKENS=1200
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=2000
AI_REQUESTS_PER_MINUTE=20
