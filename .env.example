# RedPath safety defaults
ENVIRONMENT=lab
ALLOWED_CIDRS=192.168.56.0/24,10.10.10.0/24
DRY_RUN=true
RECON_TIMEOUT_SECONDS=30
WAZUH_INDEXER_URL=https://wazuh-indexer.local:9200
WAZUH_VERIFY_TLS=true
# Comma-separated token:role mappings for protected case and analysis endpoints.
# Example for local development only: REDPATH_API_KEYS=replace-with-secret:soc_lead
REDPATH_API_KEYS=
